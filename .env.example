# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Doctor registration (local dev)
# Server uses admin.createUser (no confirmation email). On auth rate limit, saves a draft application.
# ALLOW_DOCTOR_REGISTRATION_DEV_BYPASS=true
# NEXT_PUBLIC_DEV_DOCTOR_REGISTRATION=true

# Supabase
# Use the legacy JWT keys from Project Settings → API (anon / service_role).
# Values usually start with eyJ... — not sb_publishable_ / sb_secret_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional on public-read pages; required for admin/auth admin APIs.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook endpoint: /api/webhooks/stripe (or /api/stripe/webhook)
# Listen for: checkout.session.completed, invoice.payment_succeeded
STRIPE_WEBHOOK_SECRET=

# Appointment email (Resend)
# Notifications go here until you set the client's address:
APPOINTMENT_NOTIFY_EMAIL=shantchokder@gmail.com
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Optional — defaults to HealthiConnect <onboarding@resend.dev> for testing
EMAIL_FROM=HealthiConnect <onboarding@resend.dev>
